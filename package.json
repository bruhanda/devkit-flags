{
  "name": "@devkit/flags",
  "version": "0.1.0",
  "description": "Zero-dependency, type-safe feature flags for TypeScript. Core ≤3 KB gzipped, isomorphic, sync evaluation with percentage rollouts and targeting. Opt-in sources and framework adapters via subpath imports.",
  "license": "MIT",
  "author": "Vasyl Bruhanda",
  "homepage": "https://github.com/j09822475-dev/devkit-flags#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/j09822475-dev/devkit-flags.git"
  },
  "bugs": {
    "url": "https://github.com/j09822475-dev/devkit-flags/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "flags": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./errors": {
      "types": "./dist/errors/index.d.ts",
      "import": "./dist/errors/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js"
    },
    "./matchers/extended": {
      "types": "./dist/matchers/extended/index.d.ts",
      "import": "./dist/matchers/extended/index.js"
    },
    "./validators/standard-schema": {
      "types": "./dist/validators/standard-schema/index.d.ts",
      "import": "./dist/validators/standard-schema/index.js"
    },
    "./sources/json": {
      "types": "./dist/sources/json/index.d.ts",
      "import": "./dist/sources/json/index.js"
    },
    "./sources/env": {
      "types": "./dist/sources/env/index.d.ts",
      "import": "./dist/sources/env/index.js"
    },
    "./sources/remote": {
      "types": "./dist/sources/remote/index.d.ts",
      "import": "./dist/sources/remote/index.js"
    },
    "./sources/compose": {
      "types": "./dist/sources/compose/index.d.ts",
      "import": "./dist/sources/compose/index.js"
    },
    "./adapters/react": {
      "types": "./dist/adapters/react/index.d.ts",
      "import": "./dist/adapters/react/index.js"
    },
    "./adapters/next": {
      "types": "./dist/adapters/next/index.d.ts",
      "import": "./dist/adapters/next/index.js"
    },
    "./adapters/sveltekit": {
      "types": "./dist/adapters/sveltekit/index.d.ts",
      "import": "./dist/adapters/sveltekit/index.js"
    },
    "./adapters/vue": {
      "types": "./dist/adapters/vue/index.d.ts",
      "import": "./dist/adapters/vue/index.js"
    },
    "./adapters/hono": {
      "types": "./dist/adapters/hono/index.d.ts",
      "import": "./dist/adapters/hono/index.js"
    },
    "./adapters/express": {
      "types": "./dist/adapters/express/index.d.ts",
      "import": "./dist/adapters/express/index.js"
    },
    "./adapters/openfeature": {
      "types": "./dist/adapters/openfeature/index.d.ts",
      "import": "./dist/adapters/openfeature/index.js"
    },
    "./observe": {
      "types": "./dist/observe/index.d.ts",
      "import": "./dist/observe/index.js"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "import": "./dist/cli/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "feature-flags",
    "feature-flag",
    "feature-toggle",
    "feature-toggles",
    "flags",
    "rollout",
    "percentage-rollout",
    "ab-testing",
    "kill-switch",
    "remote-config",
    "typescript",
    "type-safe",
    "zero-dependency",
    "edge",
    "edge-runtime",
    "isomorphic",
    "cloudflare-workers",
    "vercel-edge",
    "deno",
    "bun",
    "react",
    "nextjs",
    "sveltekit",
    "vue",
    "hono",
    "openfeature",
    "consistent-hashing",
    "fnv-1a",
    "launchdarkly-alternative",
    "unleash-alternative"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:types": "vitest run --typecheck",
    "test:coverage": "vitest run --coverage",
    "bench": "vitest bench",
    "lint": "biome check .",
    "format": "biome format --write .",
    "size": "size-limit",
    "publint": "publint",
    "attw": "attw --pack .",
    "release": "changeset publish",
    "prepublishOnly": "npm run build && npm run publint && npm run attw && npm run size"
  },
  "peerDependencies": {
    "@openfeature/server-sdk": ">=1.13 <2",
    "@sveltejs/kit": ">=2 <3",
    "express": ">=4 <6",
    "hono": ">=4 <5",
    "next": ">=13.4 <16",
    "react": ">=18 <20",
    "vue": ">=3.3 <4"
  },
  "peerDependenciesMeta": {
    "@openfeature/server-sdk": {
      "optional": true
    },
    "@sveltejs/kit": {
      "optional": true
    },
    "express": {
      "optional": true
    },
    "hono": {
      "optional": true
    },
    "next": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.16.0",
    "@biomejs/biome": "^1.9.0",
    "@changesets/cli": "^2.27.0",
    "@cloudflare/vitest-pool-workers": "^0.5.0",
    "@cloudflare/workers-types": "^4.20240925.0",
    "@openfeature/server-sdk": "^1.13.0",
    "@size-limit/preset-small-lib": "^11.1.0",
    "@testing-library/react": "^16.0.0",
    "@types/express": "^4.17.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@vitest/coverage-v8": "^2.0.0",
    "@vue/test-utils": "^2.4.0",
    "express": "^4.19.0",
    "hono": "^4.6.0",
    "jsdom": "^25.0.0",
    "msw": "^2.4.0",
    "next": "^14.2.0",
    "publint": "^0.2.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "size-limit": "^11.1.0",
    "supertest": "^7.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0",
    "vue": "^3.4.0"
  },
  "size-limit": [
    {
      "name": "core",
      "path": "dist/index.js",
      "limit": "3 KB"
    },
    {
      "name": "errors",
      "path": "dist/errors/index.js",
      "limit": "0.4 KB"
    },
    {
      "name": "matchers/extended",
      "path": "dist/matchers/extended/index.js",
      "limit": "0.6 KB"
    },
    {
      "name": "validators/standard-schema",
      "path": "dist/validators/standard-schema/index.js",
      "limit": "0.4 KB"
    },
    {
      "name": "sources/json",
      "path": "dist/sources/json/index.js",
      "limit": "0.7 KB"
    },
    {
      "name": "sources/env",
      "path": "dist/sources/env/index.js",
      "limit": "0.5 KB"
    },
    {
      "name": "sources/remote",
      "path": "dist/sources/remote/index.js",
      "limit": "1 KB"
    },
    {
      "name": "sources/compose",
      "path": "dist/sources/compose/index.js",
      "limit": "0.4 KB"
    },
    {
      "name": "adapters/react",
      "path": "dist/adapters/react/index.js",
      "limit": "0.7 KB"
    },
    {
      "name": "adapters/next",
      "path": "dist/adapters/next/index.js",
      "limit": "0.6 KB"
    },
    {
      "name": "adapters/sveltekit",
      "path": "dist/adapters/sveltekit/index.js",
      "limit": "0.4 KB"
    },
    {
      "name": "adapters/vue",
      "path": "dist/adapters/vue/index.js",
      "limit": "0.5 KB"
    },
    {
      "name": "adapters/hono",
      "path": "dist/adapters/hono/index.js",
      "limit": "0.4 KB"
    },
    {
      "name": "adapters/express",
      "path": "dist/adapters/express/index.js",
      "limit": "0.5 KB"
    },
    {
      "name": "adapters/openfeature",
      "path": "dist/adapters/openfeature/index.js",
      "limit": "1 KB"
    },
    {
      "name": "observe",
      "path": "dist/observe/index.js",
      "limit": "0.3 KB"
    }
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
